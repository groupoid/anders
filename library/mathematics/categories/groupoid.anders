{- Category Theory: https://anders.groupoid.space/mathematics/categories/groupoid/

   - Categorical Groupoid.

   HoTT 9.9 The Rezk completion

   Copyright (c) Groupoid Infinity, 2016-2026. -}

module groupoid where
import library/foundations/univalent/path
import library/mathematics/categories/category

def PathCat (X: U): cat := (X, \ (x y : X), PathP (<_>X) x y)

def isCatGroupoid (C: cat): U := Σ
    (id: Π (x: C.1), C.2 x x)
    (c: Π (x y z:C.1), C.2 x y -> C.2 y z -> C.2 x z)
    (HomSet: Π (x y: C.1), isSet (C.2 x y))
    (inv: Π (x y: C.1), C.2 x y -> C.2 y x)
    (inv-left: Π (x y: C.1) (p: C.2 x y), Path (C.2 x x) (c x y x p (inv x y p)) (id x))
    (inv-right: Π (x y: C.1) (p: C.2 x y), Path (C.2 y y) (c y x y (inv x y p) p) (id y))
    (left: Π (x y: C.1) (f: C.2 x y), Path (C.2 x y) f (c x x y (id x) f))
    (right: Π (x y: C.1) (f: C.2 x y), Path (C.2 x y) f (c x y y f (id y)))
    (assoc: Π (x y z w: C.1) (f: C.2 x y) (g: C.2 y z) (h: C.2 z w), Path (C.2 x w) (c x z w (c x y z f g) h) (c x y w f (c y z w g h)))
    (assoc-inv: Π (x y z w: C.1) (f: C.2 x y) (g: C.2 y z) (h: C.2 z w), Path (C.2 x w) (c x y w f (c y z w g h)) (c x z w (c x y z f g) h)),
    Π (x: C.1), Path (C.2 x x) (c x x x (id x) (id x)) (id x)

def CatGroupoid (X : U) (G : isGroupoid X)
  : isCatGroupoid (PathCat X)
 := ( idp X,
      comp-Path X,
      G,
      sym X,
      comp-inv-Path⁻¹ X,
      comp-inv-Path X,
      comp-Path-left X,
      comp-Path-right X,
      comp-Path-assoc X,
      comp-Path-assoc-inv X,
      comp-Path-id-id X
    )
