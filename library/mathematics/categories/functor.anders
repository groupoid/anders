{- Category Theory: https://anders.groupoid.space/mathematics/categories/functor/

   - Functor;
   - Coslice Category;
   - Universal Arrow;
   - Equivalence.

   HoTT 9.2 Functors and transformations
   HoTT 9.4 Equivalences

   Copyright (c) Groupoid Infinity, 2016-2026. -}

module functor where
import library/mathematics/categories/category

def catfunctor (A B: precategory): U := Σ
    (ob: A.1.1 -> B.1.1)
    (mor: Π (x y: A.1.1), A.1.2 x y -> B.1.2 (ob x) (ob y))
    (id: Π (x: A.1.1), Path (B.1.2 (ob x) (ob x)) (mor x x (A.2.id x)) (B.2.id (ob x))),
    Π (x y z: A.1.1) (f: A.1.2 x y) (g: A.1.2 y z),
    Path (B.1.2 (ob x) (ob z)) (mor x z (A.2.∘ x y z f g)) (B.2.∘ (ob x) (ob y) (ob z) (mor x y f) (mor y z g))

-- Instances

def idFunctor (A: precategory): catfunctor A A :=
    (λ (x: A.1.1), x,
     λ (x y: A.1.1) (h: A.1.2 x y), h,
     λ (x: A.1.1), <_> A.2.id x,
     λ (x y z: A.1.1) (f: A.1.2 x y) (g: A.1.2 y z), <_> A.2.∘ x y z f g)

def compFunctor (A B C: precategory) (F: catfunctor A B) (G: catfunctor B C): catfunctor A C :=
    (λ (x: A.1.1), G.ob (F.ob x),
     λ (x y: A.1.1) (h: A.1.2 x y), G.mor (F.ob x) (F.ob y) (F.mor x y h),
     λ (x: A.1.1), pcomp (C.1.2 (G.ob (F.ob x)) (G.ob (F.ob x))) (G.mor (F.ob x) (F.ob x) (F.mor x x (A.2.id x)))
       (G.mor (F.ob x) (F.ob x) (B.2.id (F.ob x))) (C.2.id (G.ob (F.ob x))) (<i> G.mor (F.ob x) (F.ob x) (F.id x @ i)) (G.id (F.ob x)),
     λ (x y z: A.1.1) (f: A.1.2 x y) (g: A.1.2 y z), pcomp (C.1.2 (G.ob (F.ob x)) (G.ob (F.ob z)))
       (G.mor (F.ob x) (F.ob z) (F.mor x z (A.2.∘ x y z f g)))
       (G.mor (F.ob x) (F.ob z) (B.2.∘ (F.ob x) (F.ob y) (F.ob z) (F.mor x y f) (F.mor y z g)))
       (C.2.∘ (G.ob (F.ob x)) (G.ob (F.ob y)) (G.ob (F.ob z)) (G.mor (F.ob x) (F.ob y) (F.mor x y f))
       (G.mor (F.ob y) (F.ob z) (F.mor y z g))) (<i> G.mor (F.ob x) (F.ob z) (F.2.2.2 x y z f g @ i))
       (G.2.2.2 (F.ob x) (F.ob y) (F.ob z) (F.mor x y f) (F.mor y z g)))

def compFunctor' (A B C: precategory) (F: catfunctor B C) (G: catfunctor A B): catfunctor A C := compFunctor A B C G F

def catᵒᵖF (A B: precategory) (F: catfunctor A B) : catfunctor (catᵒᵖ A) (catᵒᵖ B)
 := (F.ob,
     λ (x y: A.1.1) (h: A.1.2 y x), F.mor y x h,
     λ (x: A.1.1), F.id x,
     λ (x y z: A.1.1) (f: A.1.2 y x) (g: A.1.2 z y), F.2.2.2 z y x g f)
