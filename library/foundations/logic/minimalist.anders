module minimalist where

import library/foundations/mltt/nat
import library/foundations/mltt/sigma
import library/foundations/univalent/path
import library/mathematics/analysis/topology

{- A Foundation for the Core Mathematician
   arXiv:2605.03868
   David Mumford and Sy-David Friedman -}

-- 1. Foundation: The Real Numbers
axiom R : U
axiom isSetR : isSet R

-- Subsets as predicates. Since U:U1, R->U is in U1.
def Subset (X : U) : U₁ := X → U

-- 2. Axiom of Dependent Choice (DC)
axiom DC
  (X : U)
  (Rel : X → X → U)
  (h : Π (x : X), Sigma X (λ (y : X), Rel x y))
  (x0 : X)
  : Sigma (ℕ → X) (λ (f : ℕ → X), Sigma (Path X (f zero) x0) (λ (_ : Path X (f zero) x0), Π (n : ℕ), Rel (f n) (f (succ n))))

-- 3. Lebesgue Measure and Null Sets
-- isNull takes a Subset (U1) and returns a proposition (U).
axiom isNull : Subset R → U

axiom nullCountableUnion
  (f : ℕ → Subset R)
  (h : Π (n : ℕ), isNull (f n))
  : isNull (λ (x : R), Sigma ℕ (λ (n : ℕ), f n x))

-- 4. Freiling's Axiom of Symmetry (A_null^N)
axiom FreilingSymmetry
  (f : R → Subset R)
  (h : Π (x : R), isNull (f x))
  : Sigma R (λ (x : R), Sigma R (λ (y : R), prod (f x y → 𝟎) (f y x → 𝟎)))

-- 5. The Measurability Axiom
axiom isMeasurable : Subset R → U
axiom hasBaireProperty : Subset R → U
axiom perfectSetProperty : Subset R → U

axiom allMeasurable (P : Subset R) : isMeasurable P
axiom allBaire (P : Subset R) : hasBaireProperty P
axiom allPerfect (P : Subset R) : perfectSetProperty P
