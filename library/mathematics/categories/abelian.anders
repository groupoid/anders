module abelian where
import library/mathematics/categories/category
import library/mathematics/homotopy/truncation

-- David Elinder Master Thesis
-- Investigating Abelian categories in univalent type theory
-- Supervisor: Thierry Coquand
-- https://odr.chalmers.se/server/api/core/bitstreams/1e433d84-c3b8-4010-b71f-4fe204ff6cf1/content

def zeroObject(C: precategory) (X: C.1.1): U₁
 := Σ (bot: isInitial C X), isTerminal C X

def hasZeroObject (C: precategory) : U₁
 := Σ (ob: C.1.1), zeroObject C ob

def hasAllProducts (C: precategory) : U₁
 := Σ (product: C.1.1 -> C.1.1 -> C.1.1)
      (π₁: Π (A B : C.1.1), C.1.2 (product A B) A),
      Π (A B : C.1.1), C.1.2 (product A B) B

def hasAllCoproducts (C: precategory) : U₁
 := Σ (coproduct: C.1.1 -> C.1.1 -> C.1.1)
      (σ₁: Π (A B : C.1.1), C.1.2 A (coproduct A B)),
      Π (A B : C.1.1), C.1.2 B (coproduct A B)

def isMonic (P: precategory) (Y Z : P.1.1) (f : P.1.2 Y Z) : U
 := Π (X : P.1.1) (g1 g2 : P.1.2 X Y),
    Path (P.1.2 X Z) (P.2.∘ X Y Z g1 f) (P.2.∘ X Y Z g2 f)
 -> Path (P.1.2 X Y) g1 g2

def isEpic (P : precategory) (X Y : P.1.1) (f : P.1.2 X Y) : U
 := Π (Z : P.1.1) (g1 g2 : P.1.2 Y Z),
    Path (P.1.2 X Z) (P.2.∘ X Y Z f g1) (P.2.∘ X Y Z f g2)
 -> Path (P.1.2 Y Z) g1 g2

def kernel (C: precategory) (zero: hasZeroObject C)
    (A B S: C.1.1) (f: C.1.2 A B) : U₁
 := Σ (k: C.1.2 S A), isMonic C S A k

def cokernel (C: precategory) (zero: hasZeroObject C)
    (A B S: C.1.1) (f: C.1.2 A B)  : U₁
 := Σ (k: C.1.2 B S), isEpic C B S k

def isKernel (C: precategory) (zero: hasZeroObject C)
    (A B S: C.1.1) (f: C.1.2 A B) (k: C.1.2 S A) : U₁
 := Σ (ker: kernel C zero A B S f), Path (C.1.2 S A) ker.k k

def isCokernel (C: precategory) (zero: hasZeroObject C)
    (A B S: C.1.1) (f: C.1.2 A B) (k: C.1.2 B S) : U₁
 := Σ (coker: cokernel C zero A B S f), Path (C.1.2 B S) coker.k k

def hasKernel (C: precategory) (zero: hasZeroObject C)
    (A B: C.1.1) (f: C.1.2 A B) : U₁
 := ‖_‖₋₁ (isMonic C A B f)

def hasCokernel (C: precategory) (zero: hasZeroObject C)
    (A B: C.1.1) (f: C.1.2 A B) : U₁
 := ‖_‖₋₁ (isEpic C A B f)

def hasAllKernels (C : precategory) (zero: hasZeroObject C) : U₁
 := Σ (A B : C.1.1) (f : C.1.2 A B), hasKernel C zero A B f

def hasAllCokernels (C : precategory) (zero: hasZeroObject C) : U₁
 := Σ (A B : C.1.1) (f : C.1.2 A B), hasCokernel C zero A B f

def isAbelian (C: precategory): U₁
 := Σ (zero:      hasZeroObject C)
      (prod:     hasAllProducts C)
      (coprod: hasAllCoproducts C)
      (ker:       hasAllKernels C zero)
      (coker:   hasAllCokernels C zero)
      (monicsAreKernels:
         Π (A S: C.1.1) (k: C.1.2 S A),
         ‖_‖₋₁ (Σ (B: C.1.1) (f: C.1.2 A B),
                  isKernel C zero A B S f k)),
      Π (B S: C.1.1) (k: C.1.2 B S),
      ‖_‖₋₁ (Σ (A: C.1.1) (f: C.1.2 A B),
               isCokernel C zero A B S f k)
