module homology where
import library/foundations/mltt/sigma
import library/foundations/mltt/bool
import library/foundations/univalent/path
import library/foundations/univalent/prop
import library/mathematics/algebra/algebra
import library/mathematics/homotopy/truncation

def isGroupKer (G H: group) (f: G.1.1 -> H.1.1) (x: G.1.1): U
  := Path H.1.1 (f x) (idGroup H)

def isGroupIm (G H: group) (f: G.1.1 -> H.1.1) (g: H.1.1): U
  := ‖_‖₋₁ (fiber G.1.1 H.1.1 f g)

-- Helpers for Homology

axiom lemma_group_inv_id (G : group) : Path G.1.1 (invGroup G (idGroup G)) (idGroup G)
axiom lem_grouphom_inv (G H : group) (phi : grouphom G H) (x : G.1.1) : Path H.1.1 (phi.1 (invGroup G x)) (invGroup H (phi.1 x))
axiom hs-is-prop (S : U) (A : U) : isProp (hs S A)
axiom lem_abgrouphom_id (G H : abgroup) (f : abgrouphom G H) : Path H.1.1 (f.1 (idCGroup G)) (idCGroup H)

def propUnit : isProp 𝟏 := contr-impl-prop 𝟏 (★, λ (x : 𝟏), <i> 𝟏-contr x @ -i)
def setUnit : isSet 𝟏 := propSet' 𝟏 propUnit

def monoidUnit : monoid
  := ( (𝟏, setUnit)
     , ( (λ (_ _ : 𝟏), ★)
       , ( (λ (_ _ _ : 𝟏), <_> ★)
         , ( ★
           , ( (λ (x : 𝟏), <i> 𝟏-contr x @ -i)
             , (λ (x : 𝟏), <i> 𝟏-contr x @ -i) ) ) ) ) )

def groupUnit : group
  := ( (𝟏, setUnit)
     , ( monoidUnit.2
       , ( (λ (_ : 𝟏), ★)
         , ( (λ (x : 𝟏), <_> ★)
           , (λ (x : 𝟏), <_> ★) ) ) ) )

-- Kernels and Images as Subgroups

def grouphom' (G H : group) : U := Σ (f : G.1.1 -> H.1.1), prod (isGroupHom G H f) (Path H.1.1 (f (idGroup G)) (idGroup H))

def kerProp' (G H: group) (phi: grouphom' G H) : subgroupProp G
  := ( (λ (x : G.1.1), isGroupKer G H phi.1 x)
     , (λ (x : G.1.1) (p q : isGroupKer G H phi.1 x), H.1.2 (phi.1 x) (idGroup H) p q)
     , (phi.2.2)
     , (λ (x : G.1.1) (p : isGroupKer G H phi.1 x),
          comp-Path H.1.1 (phi.1 (invGroup G x)) (invGroup H (phi.1 x)) (idGroup H)
            (lem_grouphom_inv G H (phi.1, phi.2.1) x)
            (comp-Path H.1.1 (invGroup H (phi.1 x)) (invGroup H (idGroup H)) (idGroup H)
              (<i> invGroup H (p @ i))
              (lemma_group_inv_id H)))
     , (λ (g1 g2 : G.1.1) (p : isGroupKer G H phi.1 g1) (q : isGroupKer G H phi.1 g2),
          comp-Path H.1.1 (phi.1 (opGroup G g1 g2)) (opGroup H (phi.1 g1) (phi.1 g2)) (idGroup H)
            (phi.2.1 g1 g2)
            (comp-Path H.1.1 (opGroup H (phi.1 g1) (phi.1 g2)) (opGroup H (idGroup H) (idGroup H)) (idGroup H)
              (<i> opGroup H (p @ i) (q @ i))
              ((hasIdGroup H).1 (idGroup H))))
     , ★)

def imProp (G H : group) (phi : grouphom' G H) : subgroupProp H
  := ( (λ (x : H.1.1), isGroupIm G H phi.1 x)
     , (λ (x : H.1.1), hs-is-prop (sphere zero) (fiber G.1.1 H.1.1 phi.1 x))
     , (trunc₁ (fiber G.1.1 H.1.1 phi.1 (idGroup H)) zero (idGroup G, <i> phi.2.2 @ i))
     , (λ (x : H.1.1) (p : isGroupIm G H phi.1 x),
          trunc-ind (fiber G.1.1 H.1.1 phi.1 x) zero (λ (y : ‖_‖₋₁ (fiber G.1.1 H.1.1 phi.1 x)), isGroupIm G H phi.1 (invGroup H x))
            (λ (u : fiber G.1.1 H.1.1 phi.1 x), trunc₁ (fiber G.1.1 H.1.1 phi.1 (invGroup H x)) zero
               (invGroup G u.1,
                comp-Path H.1.1 (phi.1 (invGroup G u.1)) (invGroup H (phi.1 u.1)) (invGroup H x)
                  (lem_grouphom_inv G H (phi.1, phi.2.1) u.1)
                  (<i> invGroup H (u.2 @ i))))
            (λ (f : sphere zero -> hs (sphere zero) (fiber G.1.1 H.1.1 phi.1 x)) (nF : Π (s : sphere zero), isGroupIm G H phi.1 (invGroup H x)),
               hub' (sphere zero) (fiber G.1.1 H.1.1 phi.1 (invGroup H x)) (λ (s : sphere zero), nF s))
            (λ (f : sphere zero -> hs (sphere zero) (fiber G.1.1 H.1.1 phi.1 x)) (nF : Π (s : sphere zero), isGroupIm G H phi.1 (invGroup H x)) (s : sphere zero),
               spoke' (sphere zero) (fiber G.1.1 H.1.1 phi.1 (invGroup H x)) (λ (s' : sphere zero), nF s') s)
            p)
     , (λ (g1 g2 : H.1.1) (p1 : isGroupIm G H phi.1 g1) (p2 : isGroupIm G H phi.1 g2),
          trunc-ind (fiber G.1.1 H.1.1 phi.1 g1) zero (λ (y : ‖_‖₋₁ (fiber G.1.1 H.1.1 phi.1 g1)), isGroupIm G H phi.1 (opGroup H g1 g2))
            (λ (u : fiber G.1.1 H.1.1 phi.1 g1), trunc-ind (fiber G.1.1 H.1.1 phi.1 g2) zero (λ (z : ‖_‖₋₁ (fiber G.1.1 H.1.1 phi.1 g2)), isGroupIm G H phi.1 (opGroup H g1 g2))
              (λ (v : fiber G.1.1 H.1.1 phi.1 g2), trunc₁ (fiber G.1.1 H.1.1 phi.1 (opGroup H g1 g2)) zero
                (opGroup G u.1 v.1,
                 comp-Path H.1.1 (phi.1 (opGroup G u.1 v.1)) (opGroup H (phi.1 u.1) (phi.1 v.1)) (opGroup H g1 g2)
                   (phi.2.1 u.1 v.1)
                   (<i> opGroup H (u.2 @ i) (v.2 @ i))))
              (λ (f : sphere zero -> hs (sphere zero) (fiber G.1.1 H.1.1 phi.1 g2)) (nF : Π (s : sphere zero), isGroupIm G H phi.1 (opGroup H g1 g2)),
                 hub' (sphere zero) (fiber G.1.1 H.1.1 phi.1 (opGroup H g1 g2)) (λ (s : sphere zero), nF s))
              (λ (f : sphere zero -> hs (sphere zero) (fiber G.1.1 H.1.1 phi.1 g2)) (nF : Π (s : sphere zero), isGroupIm G H phi.1 (opGroup H g1 g2)) (s : sphere zero),
                 spoke' (sphere zero) (fiber G.1.1 H.1.1 phi.1 (opGroup H g1 g2)) (λ (s' : sphere zero), nF s') s)
              p2)
            (λ (f : sphere zero -> hs (sphere zero) (fiber G.1.1 H.1.1 phi.1 g1)) (nF : Π (s : sphere zero), isGroupIm G H phi.1 (opGroup H g1 g2)),
               hub' (sphere zero) (fiber G.1.1 H.1.1 phi.1 (opGroup H g1 g2)) (λ (s : sphere zero), nF s))
            (λ (f : sphere zero -> hs (sphere zero) (fiber G.1.1 H.1.1 phi.1 g1)) (nF : Π (s : sphere zero), isGroupIm G H phi.1 (opGroup H g1 g2)) (s : sphere zero),
               spoke' (sphere zero) (fiber G.1.1 H.1.1 phi.1 (opGroup H g1 g2)) (λ (s' : sphere zero), nF s') s)
            p1)
     , ★)

def kerGroup (G H : group) (phi : grouphom' G H) : group
  := subgroup G (kerProp' G H phi)

def imGroup (G H : group) (psi : grouphom' G H) : group
  := subgroup H (imProp G H psi)

def relKerIm (G H : group) (phi : grouphom' G H) (x y : H.1.1) : U
  := ‖_‖₋₁ (fiber G.1.1 H.1.1 phi.1 (rdiv H x y))

-- Chain Complexes

def abgrouphomcomp (G H K : abgroup) (f : abgrouphom G H) (g : abgrouphom H K) : abgrouphom G K
 := (λ (x : G.1.1), g.1 (f.1 x), λ (x y : G.1.1), comp-Path K.1.1 (g.1 (f.1 (opGroup (abgroup' G) x y)))
    (g.1 (opGroup (abgroup' H) (f.1 x) (f.1 y))) (opGroup (abgroup' K) (g.1 (f.1 x)) (g.1 (f.1 y))) (<i> g.1 (f.2 x y @ i)) (g.2 (f.1 x) (f.1 y)))

def trivabgrouphom (G H : abgroup) : abgrouphom G H
 := (λ (_ : G.1.1), idCGroup H, λ (x y : G.1.1), <i> (hasIdGroup (abgroup' H)).1 (idCGroup H) @ -i)

def succ2 (n : ℕ) : ℕ := succ (succ n)

def chainComplex : U₁
 := Σ (K : ℕ -> abgroup) (hom : Π (n : ℕ), abgrouphom (K (succ n)) (K n)),
    Π (n : ℕ), Path (abgrouphom (K (succ2 n)) (K n))
      (abgrouphomcomp (K (succ2 n)) (K (succ n)) (K n) (hom (succ n)) (hom n))
      (trivabgrouphom (K (succ2 n)) (K n))

def CC_K (C : chainComplex) (n : ℕ) : abgroup := C.1 n
def CC_K' (C : chainComplex) (n : ℕ) : group := abgroup' (CC_K C n)
def CC_hom (C : chainComplex) (n : ℕ) : abgrouphom (CC_K C (succ n)) (CC_K C n) := C.2.1 n
def CC_hom' (C : chainComplex) (n : ℕ) : grouphom' (CC_K' C (succ n)) (CC_K' C n)
 := ((CC_hom C n).1, ((CC_hom C n).2, lem_abgrouphom_id (CC_K C (succ n)) (CC_K C n) (CC_hom C n)))

def propZ (C : chainComplex) (n : ℕ) : subgroupProp (CC_K' C (succ n))
 := kerProp' (CC_K' C (succ n)) (CC_K' C n) (CC_hom' C n)

def Z (C : chainComplex) (n : ℕ) : group := subgroup (CC_K' C (succ n)) (propZ C n)

def B (C : chainComplex) (n : ℕ) : normalSubgroupProp (Z C n)
 := abelianSubgroupIsNormal (abelianSubgroupIsAbelian (CC_K C (succ n)) (propZ C n))
    (subgroupSubgroup (CC_K' C (succ n)) (imProp (CC_K' C (succ (succ n))) (CC_K' C (succ n)) (CC_hom' C (succ n))) (propZ C n))

def Homology (C : chainComplex) (n : ℕ)
  : group
 := factorGroup (Z C n) (B C n)
