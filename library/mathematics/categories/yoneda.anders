module yoneda where

import library/mathematics/categories/functor
import library/mathematics/categories/natural
import library/mathematics/categories/topos
import library/foundations/univalent/prop
import library/foundations/univalent/extensionality

-- | Functors from a small category C into the large category of sets SET.
--   Manual definition to handle large target category SET.
def catfunSET (C: precategory) : U₁ :=
  Σ (ob: Π (x: C.C.ob), SET)
    (mor: Π (x y: C.C.ob) (f: C.C.hom x y), (ob x).1 -> (ob y).1)
    (id: Π (x: C.C.ob), Path ((ob x).1 -> (ob x).1) (mor x x (C.P.id x)) (λ (a: (ob x).1), a))
    (fcomp: Π (x y z: C.C.ob) (f: C.C.hom x y) (g: C.C.hom y z),
       Path ((ob x).1 -> (ob z).1) (mor x z (C.P.∘ x y z f g)) (λ (a: (ob x).1), mor y z g (mor x y f a))), 𝟏

-- | Natural transformations between functors into SET.
def nattransSET (C: precategory) (F G: catfunSET C) : U₁ :=
  Σ (η: Π (x: C.C.ob), (F.ob x).1 -> (G.ob x).1)
    (commute: Π (x y: C.C.ob) (h: C.C.hom x y) (a: (F.ob x).1),
       Path (G.ob y).1 (η y (F.mor x y h a)) (G.mor x y h (η x a))), 𝟏

-- | The covariant hom-functor H_A = Hom(A, -)
def HomFunctor (C: precategory) (A: C.C.ob) : catfunSET C :=
    ( (λ (X: C.C.ob), ((C.C).hom A X, (C.P).homSet A X)),
      λ (X Y: C.C.ob) (f: (C.C).hom X Y) (g: (C.C).hom A X), (C.P).∘ A X Y g f,
      λ (X: C.C.ob), <i> λ (g: (C.C).hom A X), (C.P).∘-right A X g @ i,
      λ (X Y Z: C.C.ob) (f: (C.C).hom X Y) (g: (C.C).hom Y Z),
        <i> λ (h: (C.C).hom A X), (C.P).∘-assoc A X Y Z h f g @ -i, ★ )

-- | The Yoneda map: Nat(H_A, F) -> F(A)
def YonedaMap (C: precategory) (A: C.C.ob) (F: catfunSET C)
  (α: nattransSET C (HomFunctor C A) F) : (F.ob A).1 :=
    α.1 A (C.P.id A)

-- | The Yoneda inverse: F(A) -> Nat(H_A, F)
def YonedaInv (C: precategory) (A: C.C.ob) (F: catfunSET C) (u: (F.ob A).1)
  : nattransSET C (HomFunctor C A) F :=
    ( (λ (X: C.C.ob) (f: C.C.hom A X), F.mor A X f u),
      λ (X Y: C.C.ob) (h: C.C.hom X Y) (f: C.C.hom A X),
          <i> (F.fcomp A X Y f h @ i) u, ★ )

-- | Verification of Yoneda Lemma: Beta reduction.
def Yoneda-β (C: precategory) (A: C.C.ob) (F: catfunSET C) (u: (F.ob A).1)
  : Path (F.ob A).1 (YonedaMap C A F (YonedaInv C A F u)) u
 := <i> (F.id A @ i) u

-- | Auxiliary path for Yoneda-η.
--   Goes from F(f)(α_A(id_A)) to α_X(f).
def Yoneda-η-η (C: precategory) (A: C.C.ob) (F: catfunSET C) (α: nattransSET C (HomFunctor C A) F) (X: C.C.ob) (f: C.C.hom A X)
  : Path (F.ob X).1 (F.mor A X f (α.1 A (C.P.id A))) (α.1 X f)
 := comp-Path (F.ob X).1 (F.mor A X f (α.1 A (C.P.id A))) (α.1 X (C.P.∘ A A X (C.P.id A) f)) (α.1 X f)
          (<i> α.2.1 A X f (C.P.id A) @ -i)
          (<i> α.1 X (C.P.∘-left A X f @ i))

-- | Unit type is a mere proposition.
def prop-unit : isProp 𝟏 := λ (x y: 𝟏), <i> ★

-- | Naturality condition is a property for functors into SET.
def nattransSET-isProp (C: precategory) (A: C.C.ob) (F: catfunSET C) (η: Π (x: C.C.ob), C.C.hom A x -> (F.ob x).1)
  : isProp (Σ (commute: Π (x y: C.C.ob) (h: C.C.hom x y) (f: C.C.hom A x),
       Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f))), 𝟏)
 := propSig (Π (x y: C.C.ob) (h: C.C.hom x y) (f: C.C.hom A x),
       Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f))) (λ (_: Π (x y: C.C.ob) (h: C.C.hom x y) (f: C.C.hom A x), Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f))), 𝟏)
    (propPi' (C.C.ob) (λ (x: C.C.ob), Π (y: C.C.ob) (h: C.C.hom x y) (f: C.C.hom A x), Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f)))
      (λ (x: C.C.ob), propPi' (C.C.ob) (λ (y: C.C.ob), Π (h: C.C.hom x y) (f: C.C.hom A x), Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f)))
        (λ (y: C.C.ob), propPi' (C.C.hom x y) (λ (h: C.C.hom x y), Π (f: C.C.hom A x), Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f)))
          (λ (h: C.C.hom x y), propPi' (C.C.hom A x) (λ (f: C.C.hom A x), Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f)))
            (λ (f: C.C.hom A x), (F.ob y).2 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f)))))))
    (λ (_: Π (x y: C.C.ob) (h: C.C.hom x y) (f: C.C.hom A x), Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f))), prop-unit)

-- | Path between component maps for Yoneda-η.
def Yoneda-η-p (C: precategory) (A: C.C.ob) (F: catfunSET C) (α: nattransSET C (HomFunctor C A) F)
  : Path (Π (x: C.C.ob) (f: C.C.hom A x), (F.ob x).1) (YonedaInv C A F (YonedaMap C A F α)).1 α.1
 := piext (C.C.ob) (λ (x: C.C.ob), Π (f: C.C.hom A x), (F.ob x).1)
           (YonedaInv C A F (YonedaMap C A F α)).1 α.1
           (λ (x: C.C.ob), funext (C.C.hom A x) ((F.ob x).1)
                                  ((YonedaInv C A F (YonedaMap C A F α)).1 x) (α.1 x)
                                  (λ (f: C.C.hom A x), Yoneda-η-η C A F α x f))

-- | Verification of Yoneda Lemma: Inverse Property 2.
def Yoneda-η (C: precategory) (A: C.C.ob) (F: catfunSET C) (α: nattransSET C (HomFunctor C A) F)
  : Path (nattransSET C (HomFunctor C A) F) (YonedaInv C A F (YonedaMap C A F α)) α
 := lemSig' (Π (x: C.C.ob) (f: C.C.hom A x), (F.ob x).1)
            (λ (η: Π (x: C.C.ob) (f: C.C.hom A x), (F.ob x).1),
              Σ (commute: Π (x y: C.C.ob) (h: C.C.hom x y) (f: C.C.hom A x),
                 Path (F.ob y).1 (η y (C.P.∘ A x y f h)) (F.mor x y h (η x f))), 𝟏)
            (nattransSET-isProp C A F)
            (YonedaInv C A F (YonedaMap C A F α)) α
            (Yoneda-η-p C A F α)