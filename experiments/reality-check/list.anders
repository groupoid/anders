   Copyright (c) Groupoid Infinity, 2016-2026. -}

module list where
import experiments/reality-check/leibniz library/foundations/mltt/bool library/foundations/mltt/nat
option girard true

def list (α : U) : U ≔ Π (μ : U), μ → (α → μ → μ) → μ
def nil (α : U) : list α ≔ λ (μ : U) (n : μ) (c : α → μ → μ), n
def ∷ (α : U) (x : α) (xs : list α) : list α ≔ λ (μ : U) (n : μ) (c : α → μ → μ), c x (xs μ nat c)
def list-map (α β : U) (f : α → β) (xs : list α) : list β ≔ λ (μ : U) (n : μ) (c : β → μ → μ), xs μ nat (∘ α β (μ → μ) c f)
def list-pure (α : U) : α → list α ≔ λ (a : α), ∷ α a (nil α)
def lst₁ : list nat ≔ ∷ nat N0 (∷ nat N1 (∷ nat N2 (∷ nat N3 (nil N))))
def lst₂ : list nat ≔ ∷ nat N1 (∷ nat N2 (∷ nat N3 (∷ nat N4 (nil N))))

theorem map-succ-lst₁-eq-lst₂ : eq (list N) (list-map nat N succ lst₁) lst₂ ≔ refl (list N) lst₂

def append (α : U) (xs : list α) (ys : list α) : list α ≔ λ (μ : U) (n : μ) (c : α → μ → μ), xs μ (ys μ nat c) c

def five-plus-four : eq nat (plus N5 N4) N9 := refl nat N9

def lst₃ : list nat ≔ ∷ nat N0 (∷ nat N1 (nil N))
def lst₄ : list nat ≔ ∷ nat N2 (∷ nat N3 (nil N))

theorem lst₃-append-lst₄-eq-lst₁ : eq (list N) (append nat lst₃ lst₄) lst₁ ≔ refl (list N) lst₁

def join (α : U) (xs : list (list α)) : list α ≔ xs (list α) (nil α) (append α)
def lst₅ : list (list N) ≔ ∷ (list N) lst₃ (∷ (list N) lst₄ (nil (list N)))

theorem join-lst₅-eq-lst₁ : eq (list N) (join nat lst₅) lst₁ ≔ refl (list N) lst₁

def list-bind (α β : U) (x : list α) (f : α → list β) : list β ≔ join β (list-map α (list β) f x)
def monad ≔ Σ (μ : U → U) (pure : Π (α : U), α → μ α), (Π (α β : U), μ α → (α → μ β) → μ β)
def pure (μ : monad) : Π (α : U), α → μ.1 α ≔ μ.2.1
def bind (μ : monad) : Π (α β : U), μ.1 α → (α → μ.1 β) → μ.1 β ≔ μ.2.2
def map (μ : monad) (α β : U) (f : α → β) (x : μ.1 α) : μ.1 β ≔ bind μ α β x (∘ α β (μ.1 β) (pure μ β) f)

def filterM (μ : monad) (α : U) (f : α → μ.1 bool′) (lst : list α) : μ.1 (list α)
 ≔ lst (μ.1 (list α)) (pure μ (list α) (nil α))
    (λ (x : α) (xs : μ.1 (list α)), bind μ bool′ (list α) (f x)
      (λ (b : bool′), ite (μ.1 (list α))
        (map μ (list α) (list α) (∷ α x) xs) xs b))

def List : monad ≔ (list, list-pure, list-bind)
def true-false : list bool′ ≔ ∷ bool′ true′ (∷ bool′ false′ (nil bool′))
def powerset (α : U) : list α → list (list α) ≔ filterM List α (const (list bool′) α true-false)

def lst₃-powerset : list (list N) ≔
∷ (list N) lst₃
  (∷ (list N) (list-pure nat N0)
    (∷ (list N) (list-pure nat N1)
      (∷ (list N) (nil N)
        (nil (list N)))))

theorem powerset-correct-at-list₃ : eq (list (list N)) (powerset nat lst₃) lst₃-powerset
     ≔ refl (list (list N)) lst₃-powerset