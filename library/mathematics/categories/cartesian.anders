module cartesian where
import library/mathematics/categories/category
import library/mathematics/categories/functor

axiom sliceCat (C D: precategory)
      (a: (catᵒᵖ C).1.1)
      (F: catfunctor D (catᵒᵖ C))
    : precategory

-- | Cartesian Closed Category

def isCCC (C: precategory): U
 := Σ (prod: Π (A B: C.1.1), C.1.1)
      (p1: Π (A B: C.1.1), C.1.2 (prod A B) A)
      (p2: Π (A B: C.1.1), C.1.2 (prod A B) B)
      (univ: Π (A B X: C.1.1) (f: C.1.2 X A) (g: C.1.2 X B),
           isContr (Σ (h: C.1.2 X (prod A B)), (Path (C.1.2 X A) (C.2.∘ X (prod A B) A h (p1 A B)) f) ×
                   (Path (C.1.2 X B) (C.2.∘ X (prod A B) B h (p2 A B)) g)))
      (exp: Π (A B: C.1.1), C.1.1)
      (apply: Π (A B: C.1.1), C.1.2 (prod (exp A B) A) B)
      (curry: Π (A B X: C.1.1) (f: C.1.2 (prod X A) B), isContr (Σ (g: C.1.2 X (exp A B)), Path (C.1.2 (prod X A) B)
           (C.2.∘ (prod X A) (prod (exp A B) A) B ((univ (exp A B) A (prod X A) (C.2.∘ (prod X A) X (exp A B) (p1 X A) g) (p2 X A)).1.1)
           (apply A B)) f)), terminal C
