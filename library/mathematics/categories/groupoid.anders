{- Category Theory: https://anders.groupoid.space/mathematics/categories/groupoid/

   - Categorical Groupoid.

   HoTT 9.9 The Rezk completion

   Copyright (c) Groupoid Infinity, 2016-2026. -}

module groupoid where
import library/foundations/univalent/path
import library/mathematics/categories/category
option irrelevance true

def comp-Path-assoc-inv (A : U) (a b c d : A) (f : Path A a b) (g : Path A b c) (h : Path A c d)
  : Path (Path A a d) (comp-Path A a b d f (comp-Path A b c d g h)) (comp-Path A a c d (comp-Path A a b c f g) h)
 := sym (Path A a d) (comp-Path A a c d (comp-Path A a b c f g) h) (comp-Path A a b d f (comp-Path A b c d g h)) (comp-Path-assoc A a b c d f g h)

def comp-Path-id-id (A : U) (x : A)
  : Path (Path A x x) (comp-Path A x x x (idp A x) (idp A x)) (idp A x)
 := sym (Path A x x) (idp A x) (comp-Path A x x x (idp A x) (idp A x)) (comp-Path-left A x x (idp A x))

def PathCat (X: U): cat := (X, \ (x y : X), PathP (<_>X) x y, star)

def isCatGroupoid (C: cat): U := Σ
    (id: Π (x: C.ob), C.hom x x)
    (c: Π (x y z:C.ob), C.hom x y -> C.hom y z -> C.hom x z)
    (HomSet: Π (x y: C.ob), isSet (C.hom x y))
    (inv: Π (x y: C.ob), C.hom x y -> C.hom y x)
    (inv-left: Π (x y: C.ob) (p: C.hom x y), Path (C.hom x x) (c x y x p (inv x y p)) (id x))
    (inv-right: Π (x y: C.ob) (p: C.hom x y), Path (C.hom y y) (c y x y (inv x y p) p) (id y))
    (left: Π (x y: C.ob) (f: C.hom x y), Path (C.hom x y) f (c x x y (id x) f))
    (right: Π (x y: C.ob) (f: C.hom x y), Path (C.hom x y) f (c x y y f (id y)))
    (assoc: Π (x y z w: C.ob) (f: C.hom x y) (g: C.hom y z) (h: C.hom z w),
      Path (C.hom x w) (c x z w (c x y z f g) h) (c x y w f (c y z w g h)))
    (assoc-inv: Π (x y z w: C.ob) (f: C.hom x y) (g: C.hom y z) (h: C.hom z w),
      Path (C.hom x w) (c x y w f (c y z w g h)) (c x z w (c x y z f g) h))
    (id-id: Π (x: C.ob), Path (C.hom x x) (c x x x (id x) (id x)) (id x)), unit

def CatGroupoid (X : U) (G : isGroupoid X)
  : isCatGroupoid (PathCat X)
 := ( idp X,
      comp-Path X,
      G,
      sym X,
      comp-inv-Path⁻¹ X,
      comp-inv-Path X,
      comp-Path-left X,
      comp-Path-right X,
      comp-Path-assoc X,
      (\ (x y z w: X) (f: Path X x y) (g: Path X y z) (h: Path X z w), sym (Path X x w) (comp-Path X x z w (comp-Path X x y z f g) h) (comp-Path X x y w f (comp-Path X y z w g h)) (comp-Path-assoc X x y z w f g h)),
      (\ (x: X), sym (Path X x x) (idp X x) (comp-Path X x x x (idp X x) (idp X x)) (comp-Path-left X x x (idp X x))),
      star
    )
