module homotopy where
import library/foundations/mltt/proto
import library/mathematics/homotopy/S1
import library/foundations/mltt/nat
import library/mathematics/algebra/int
import library/foundations/univalent/iso

-- Intermediary Type that carries number of turns of a path along the circle
-- This type is used to define the loop space of S¹ and
-- its higher-dimensional analogues

def sucPathZ : Path U ℤ ℤ := iso→Path ℤ ℤ sucZ predZ sucpredZ predsucZ
opaque helix (x : S¹) : U := S1-ind (λ (_ : S¹), U) ℤ sucPathZ x

-- Transport Helix Paths from Integers

def loopPos (n : ℕ) : Path S¹ baseS1 baseS1
 := ind-nat (λ (_ : ℕ), Path S¹ baseS1 baseS1) (idp S¹ baseS1)
            (λ (_ : ℕ) (p : Path S¹ baseS1 baseS1), pcomp S¹ baseS1 baseS1 baseS1 p loopS1) n

def loopNeg (n : ℕ) : Path S¹ baseS1 baseS1
 := ind-nat (λ (_ : ℕ), Path S¹ baseS1 baseS1) (idp S¹ baseS1)
            (λ (_ : ℕ) (p : Path S¹ baseS1 baseS1), pcomp S¹ baseS1 baseS1 baseS1 p (sym S¹ baseS1 baseS1 loopS1)) n

-- Encoding a path along S¹ as an element of helix
-- This is done by transporting an element of ℤ along S¹ using the path p
-- The result is an element of helix x, which is a path
-- along S¹ that starts at baseS1 and ends at x

-- Loops

def compS1' := pcomp S¹ baseS1 baseS1 baseS1
def loopS1' : U := Path S¹ baseS1 baseS1
def loop1 : loopS1' := loopS1
def loop2 : loopS1' := compS1' loop1 loop1
def loop3 : loopS1' := compS1' loop2 loop1
def loop4 : loopS1' := compS1' loop3 loop1

def invLoop    : loopS1'           := inv S¹ baseS1 baseS1 loop1
def oneTurn    : loopS1' → loopS1' := \ (l: loopS1'), compS1' l loop1
def oneTurnInv : loopS1' → loopS1' := \ (l: loopS1'), compS1' l invLoop

def triv : loopS1' := idp S¹ baseS1
def l0   : loopS1' := triv
def l1   : loopS1' := oneTurn l0

def loopZ  (n : ℕ) : 𝟐 → loopS1' := ind₂ (\(_: 𝟐), Path S¹ baseS1 baseS1) (loopNeg n) (loopPos n)
def turnℤ (x : loopS1') : 𝟐 → loopS1' := ind₂ (\(_: 𝟐), Path S¹ baseS1 baseS1) (oneTurnInv x) (oneTurn x)

def loopIt (n : ℤ) : Path S¹ baseS1 baseS1
 := +-ind ℕ ℕ (λ (_ : ℤ), Path S¹ baseS1 baseS1) (λ (n : ℕ), loopNeg (succ n)) loopPos n

-- Helix Path from Integer

def encode (x : S¹) (p : Path S¹ baseS1 x) : helix x
 := subst S¹ helix baseS1 x p zeroZ

-- Transport Integers from Helix Paths

def lemTransC (A : U) (a : A) : Path A (transp (<_> A) 0 a) a
 := <j> transp (<_> A) j a

def corFib1 (A : U) (F G : A -> U) (a : A) (fa ga : Π (u : F a), G a) (p : Path A a a)
  (h : Π (u : F a), Path (G a) (subst A G a a p (fa u)) (ga (subst A F a a p u)))
  : PathP (<i> Π (u : F (p @ i)), G (p @ i)) fa ga
 := J A a (λ (x y : A) (q : Path A x y), Π (fx : Π (u : F x), G x) (fy : Π (u : F y), G y),
              (Π (u : F x), Path (G y) (subst A G x y q (fx u)) (fy (subst A F x y q u))) → PathP (<i> Π (u : F (q @ i)), G (q @ i)) fx fy)
     (λ (ga' ga'' : Π (u : F a), G a) (ha : Π (u : F a), Path (G a) (transp (<_> G a) 0 (ga' u)) (ga'' (transp (<_> F a) 0 u))), <i> λ (u : F a),
        pcomp (G a) (ga' u) (ga'' (transp (<_> F a) 0 u)) (ga'' u)
        (pcomp (G a) (ga' u) (transp (<_> G a) 0 (ga' u)) (ga'' (transp (<_> F a) 0 u)) (<i> lemTransC (G a) (ga' u) @ -i) (ha u))
        (<i> ga'' (lemTransC (F a) u @ i)) @ i) a p fa ga h

-- Windings

def winding (p : loopS1') : ℤ := trans ℤ ℤ (<i> helix (p @ i)) zeroZ

def loopZ1 : ℤ := winding loop1
def loopZ2 : ℤ := winding loop2
def loopZ3 : ℤ := winding loop3
def loopZ4 : ℤ := winding loop4

-- Integer from Helix Path

{-

def decode (x : S¹) (c : helix x) : Path S¹ baseS1 x
 := S1-ind (λ (y : S¹), helix y → Path S¹ baseS1 y) loopIt
       (corFib1 S¹ helix (λ (y : S¹), Path S¹ baseS1 y) baseS1 loopIt loopIt loopS1
         (λ (u : ℤ), +-ind ℕ ℕ (λ (v : ℤ), Path (Path S¹ baseS1 baseS1) (pcomp S¹ baseS1 baseS1 baseS1 (loopIt v) loopS1) (loopIt (sucZ v)))
            (λ (n : ℕ), <j i> hcomp S¹ (∂ i ∨ j) (λ (k : I), [(i = 0) → baseS1, (i = 1) → loopS1 @ (k ∧ -j), (j = 1) → loopNeg n @ i]) (loopNeg (succ n) @ i))
            (λ (n : ℕ), <_> loopPos (succ n)) u)) x c

-- π₁(S¹) = ℤ
theorem loopS1'=Z
  : Path U loopS1' ℤ
 := iso→Path (Path S¹ baseS1 baseS1) ℤ (encode baseS1) (decode baseS1) (λ (n : ℤ), <_> n) (λ (p : Path S¹ baseS1 baseS1), <_> p)

-}
