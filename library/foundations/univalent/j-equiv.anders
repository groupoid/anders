module j-equiv where

import library/foundations/univalent/equiv

def isContr1 (A: U₁) : U₁ := Σ (x: A), Π (y: A), PathP (<_> A) x y
def isContr→isProp (A: U) (w: isContr A) (a b : A) : Path A a b
 := <i> hcomp A (∂ i) (λ (j : I), [(i = 0) → a, (i = 1) → (w.2 b) @ j]) ((<i4> w.2 a @ -i) @ i)
def subst1 (A : U₁) (P : A -> U) (a b : A) (p : PathP (<_> A) a b) (e : P a) : P b := transp (<i> P (p @ i)) 0 e
def contrEquiv (A B : U) (e : equiv A B) : PathP (<i> Σ (X : U), equiv A X) (A, idEquiv A) (B, e)
  := <i> (ua A B e @ i, transp (<j> equiv A (ua A B e @ (i ∧ j))) 0 (idEquiv A))
def EquivIsContr (A: U) : isContr1 (single A) := ((A, idEquiv A), λ (z : single A), contrEquiv A z.1 z.2)
def J-equiv (A B: U) (P: Π (A B: U), equiv A B → U) (r: P A A (idEquiv A)) (e: equiv A B) : P A B e
 := subst1 (single A) (\ (z: single A), P A z.1 z.2) (A, idEquiv A) (B, e) (contrEquiv A B e) r

