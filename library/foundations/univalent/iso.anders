{- Isomorphisms: https://anders.groupoid.space/foundations/univalent/iso/
   Copyright (c) Groupoid Infinity, 2016-2026. -}

module iso where
import library/foundations/univalent/path
import library/foundations/univalent/equiv

-- [Cohen, Coquand, Huber, Mörtberg, Joyal] 2016

def lemIso_rem0 (A B : U) (f : A -> B) (g : B -> A) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x0 : A) (p0 : Path B (f x0) y) (i : I) : A
 := hcomp A (∂ i) (λ (k : I), [ (i = 0) → t x0 @ k, (i = 1) → g y ]) (g (p0 @ i))

def lemIso_rem1 (A B : U) (f : A -> B) (g : B -> A) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x1 : A) (p1 : Path B (f x1) y) (i : I) : A
 := hcomp A (∂ i) (λ (k : I), [ (i = 0) → t x1 @ k, (i = 1) → g y ]) (g (p1 @ i))

def lemIso_p (A B : U) (f : A -> B) (g : B -> A) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x0 x1 : A) (p0 : Path B (f x0) y) (p1 : Path B (f x1) y) (i : I) : A
 := hcomp A (∂ i) (λ (k : I), [ (i = 0) → lemIso_rem0 A B f g t y x0 p0 (-k), (i = 1) → lemIso_rem1 A B f g t y x1 p1 (-k) ]) (g y)

def lemIso_fill0 (A B : U) (f : A -> B) (g : B -> A) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x0 : A) (p0 : Path B (f x0) y) (i j : I) : A
 := hcomp A (∂ i ∨ -j) (λ (k : I), [ (i = 0) → t x0 @ (j ∧ k), (i = 1) → g y, (j = 0) → g (p0 @ i) ]) (g (p0 @ i))

def lemIso_fill1 (A B : U) (f : A -> B) (g : B -> A) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x1 : A) (p1 : Path B (f x1) y) (i j : I) : A
 := hcomp A (∂ i ∨ -j) (λ (k : I), [ (i = 0) → t x1 @ (j ∧ k), (i = 1) → g y, (j = 0) → g (p1 @ i) ]) (g (p1 @ i))

def lemIso_fill2 (A B : U) (f : A -> B) (g : B -> A) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x0 x1 : A) (p0 : Path B (f x0) y) (p1 : Path B (f x1) y) (i j : I) : A
 := hcomp A (∂ i ∨ j) (λ (k : I), [ (i = 0) → lemIso_rem0 A B f g t y x0 p0 (j ∨ -k), (i = 1) → lemIso_rem1 A B f g t y x1 p1 (j ∨ -k), (j = 1) → g y ]) (g y)

def lemIso_sq (A B : U) (f : A -> B) (g : B -> A) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x0 x1 : A) (p0 : Path B (f x0) y) (p1 : Path B (f x1) y) (i j : I) : A
 := hcomp A (∂ i ∨ ∂ j) (λ (k : I), [ (i = 0) → lemIso_fill0 A B f g t y x0 p0 j (-k), (i = 1) → lemIso_fill1 A B f g t y x1 p1 j (-k), (j = 1) → g y, (j = 0) → t (lemIso_p A B f g t y x0 x1 p0 p1 i) @ (-k) ]) (lemIso_fill2 A B f g t y x0 x1 p0 p1 i j)

def lemIso_sq1 (A B : U) (f : A -> B) (g : B -> A) (s : Π (y : B), Path B (f (g y)) y) (t : Π (x : A), Path A (g (f x)) x) (y : B) (x0 x1 : A) (p0 : Path B (f x0) y) (p1 : Path B (f x1) y) (i j : I) : B
 := hcomp B (∂ i ∨ ∂ j) (λ (k : I), [ (i = 0) → s (p0 @ j) @ k, (i = 1) → s (p1 @ j) @ k, (j = 0) → s (f (lemIso_p A B f g t y x0 x1 p0 p1 i)) @ k, (j = 1) → s y @ k ]) (f (lemIso_sq A B f g t y x0 x1 p0 p1 i j))

def lemIso (A B : U) (f : A -> B) (g : B -> A) (s : Π (y : B), Path B (f (g y)) y) (t : Π (x : A), Path A (g (f x)) x) (y : B) (z : fiber A B f y) : Path (fiber A B f y) (g y, s y) z
 := <i> (lemIso_p A B f g t y (g y) z.1 (s y) z.2 i, <j> lemIso_sq1 A B f g s t y (g y) z.1 (s y) z.2 i j)

-- [Shulman, Lumsdaine, Warren, Licata] 2010

def isIso   (A B: U) (f: A → B) : U := Σ (g : B → A)     (s : section A B f g ) (t : retract A B f g ), 𝟏
def isBiInv (A B: U) (f: A → B) : U := Σ (g₁ g₂ : B → A) (s : section A B f g₁) (t : retract A B f g₂), 𝟏

def iso     (A B: U) : U := Σ (f : A → B), isIso A B f
def biinv   (A B: U) : U := Σ (f : A → B), isBiInv A B f

-- gradLemma from cubicaltt

def isoToEquiv (A B : U)
    (f : A -> B)
    (g : B -> A)
    (s : Π (y : B), Path B (f (g y)) y)
    (t : Π (x : A), Path A (g (f x)) x)
  : isEquiv A B f
 := λ (y : B), ((g y, s y), λ (z : fiber A B f y), lemIso A B f g s t y z)

def iso→Path (A B : U)
    (f : A → B)
    (g : B → A)
    (s : Π (y : B), Path B (f (g y)) y)
    (t : Π (x : A), Path A (g (f x)) x)
  : Path U A B
 := ua A B (f, isoToEquiv A B f g s t)

-- Unimorphism Type (Iso -> Path)

def uni-Form (A B: U) : U₁ := iso A B -> PathP (<_>U) A B
def uni-Intro (A B: U) : uni-Form A B := λ (x : iso A B), iso→Path A B x.1 x.2.1 x.2.2.1 x.2.2.2.1
def uni-Elim (A B : U) : PathP (<_> U) A B -> iso A B
 := λ (p : PathP (<_> U) A B),
      ( coerce A B p,
        coerce B A (<i> p @ -i),
        trans⁻¹-trans A B p, λ (a : A),
        <k> trans-trans⁻¹ A B p a @ -k,
        ★
      )

-- Minivalence Type (Iso -> Equiv)

def mini-Form (A B : U) : U := iso A B -> equiv A B
def mini-Intro (A B : U) : mini-Form A B := λ (x : iso A B), univ-elim A B (iso→Path A B x.1 x.2.1 x.2.2.1 x.2.2.2.1)
def mini-Elim (A B : U) : equiv A B -> iso A B := λ (x : equiv A B), ( x.1, inv-equiv A B x, ret-equiv A B x, sec-equiv A B x, ★)

def invEquiv (A B : U) (e : equiv A B)
  : equiv B A
 := ((mini-Elim A B e).2.1, isoToEquiv B A (mini-Elim A B e).2.1 (mini-Elim A B e).1 (mini-Elim A B e).2.2.2.1 (mini-Elim A B e).2.2.1)

-- Iso as Identity System [Sokhatsky]
-- Computable induction principle based on J-equiv in the style of Paulin-Mohring

def iso-intro (A: U)
  : iso A A
 := ( id A,
      id A,
      (\(x:A), <_>x),
      (\(x:A), <_>x),
      star
    )

def J-iso (A B: U)  (P: Π (X: U) (i: iso A X), U) (r: P A (iso-intro A)) (z: iso A B) : P B (mini-Elim A B (mini-Intro A B z))
 := subst (Σ (X : U), equiv A X) (λ (w : Σ (X : U), equiv A X), P w.1 (mini-Elim A w.1 w.2))
          (A, idEquiv A) (B, mini-Intro A B z) (contrEquiv A B (mini-Intro A B z)) r

