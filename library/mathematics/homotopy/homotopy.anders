{- Homotopy Groups: https://anders.groupoid.space/mathematics/homotopy/groups/
   Copyright (c) Groupoid Infinity, 2016-2026. -}

module homotopy where
import library/mathematics/homotopy/S1
import library/mathematics/algebra/int
import library/foundations/univalent/iso
option irrelevance true

def sucPathZ : Path U Z Z
  := iso→Path Z Z sucZ predZ sucpredZ predsucZ

-- Helix Family (Universal Cover)
def helix (x : S¹) : U
  := S1-ind (λ (_ : S¹), U) Z sucPathZ x

def encode (x : S¹) (p : Path S¹ baseS1 x) : helix x
  := subst S¹ helix baseS1 x p zeroZ

def loopN (n : ℕ) : Path S¹ baseS1 baseS1
 := ind-nat (λ (_ : ℕ), Path S¹ baseS1 baseS1) (idp S¹ baseS1) (λ (_ : ℕ) (p : Path S¹ baseS1 baseS1), pcomp S¹ baseS1 baseS1 baseS1 p loop) n

def invLoopN (n : ℕ) : Path S¹ baseS1 baseS1
 := ind-nat (λ (_ : ℕ), Path S¹ baseS1 baseS1) (idp S¹ baseS1) (λ (_ : ℕ) (p : Path S¹ baseS1 baseS1), pcomp S¹ baseS1 baseS1 baseS1 p (sym S¹ baseS1 baseS1 loop)) n

def decode_baseS1 (n : Z) : Path S¹ baseS1 baseS1
 := +-ind ℕ ℕ (λ (_ : Z), Path S¹ baseS1 baseS1) (λ (n : ℕ), invLoopN (succ n)) loopN n

def lemTransC (A : U) (a : A) : Path A (transp (<_> A) 0 a) a
  := <j> transp (<_> A) j a

def corFib1 (A : U) (F G : A -> U) (a : A) (fa ga : Π (u : F a), G a) (p : Path A a a)
  (h : Π (u : F a), Path (G a) (subst A G a a p (fa u)) (ga (subst A F a a p u)))
  : PathP (<i> Π (u : F (p @ i)), G (p @ i)) fa ga
  := J A a (λ (x y : A) (q : Path A x y), Π (fx : Π (u : F x), G x) (fy : Π (u : F y), G y), (Π (u : F x), Path (G y) (subst A G x y q (fx u)) (fy (subst A F x y q u))) → PathP (<i> Π (u : F (q @ i)), G (q @ i)) fx fy)
       (λ (ga' ga'' : Π (u : F a), G a) (ha : Π (u : F a), Path (G a) (transp (<_> G a) 0 (ga' u)) (ga'' (transp (<_> F a) 0 u))), <i> λ (u : F a),
         pcomp (G a) (ga' u) (ga'' (transp (<_> F a) 0 u)) (ga'' u)
           (pcomp (G a) (ga' u) (transp (<_> G a) 0 (ga' u)) (ga'' (transp (<_> F a) 0 u)) (<i> lemTransC (G a) (ga' u) @ -i) (ha u))
           (<i> ga'' (lemTransC (F a) u @ i)) @ i)
       a p fa ga h

def decode (x : S¹) (c : helix x) : Path S¹ baseS1 x
  := S1-ind (λ (y : S¹), helix y → Path S¹ baseS1 y)
       decode_baseS1
       (corFib1 S¹ helix (λ (y : S¹), Path S¹ baseS1 y) baseS1 decode_baseS1 decode_baseS1 loop
         (λ (u : Z), +-ind ℕ ℕ (λ (v : Z), Path (Path S¹ baseS1 baseS1) (pcomp S¹ baseS1 baseS1 baseS1 (decode_baseS1 v) loop) (decode_baseS1 (sucZ v)))
            (λ (n : ℕ), <_> invLoopN n)
            (λ (n : ℕ), <_> loopN (succ n))
            u))
       x c

-- π₁(S¹) = ℤ
def loopS1equalsZ
  : Path U (Path S¹ baseS1 baseS1) Z
 := iso→Path (Path S¹ baseS1 baseS1) Z (encode baseS1) (decode baseS1) (λ (n : Z), <_> n) ?
