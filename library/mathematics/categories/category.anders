{- Category Theory: https://anders.groupoid.space/mathematics/categories/category/

   - Precategories.
   - Rezk Completion.
   - Initial and Terminal Objects.

   HoTT 9.1 Categories and precategories

   Copyright (c) Groupoid Infinity, 2016-2026. -}

module category where
import library/foundations/mltt/sigma
import library/foundations/univalent/path
option irrelevance false

-- disable irrelevance for Unit types

def cat : U₁ := Σ (ob: U), ob -> ob -> U

def isPrecategory (C: cat) : U := Σ
    (id: Π (x: C.1), C.2 x x)
    (∘: Π (x y z: C.1), C.2 x y -> C.2 y z -> C.2 x z)
    (homSet: Π (x y: C.1), isSet (C.2 x y))
    (∘-left: Π (x y: C.1) (f: C.2 x y), Path (C.2 x y) (∘ x x y (id x) f) f)
    (∘-right: Π (x y: C.1) (f: C.2 x y), Path (C.2 x y) (∘ x y y f (id y)) f)
    (∘-assoc: Π (x y z w: C.1) (f: C.2 x y) (g: C.2 y z) (h: C.2 z w), Path (C.2 x w) (∘ x z w (∘ x y z f g) h) (∘ x y w f (∘ y z w g h)))
    (∘-assoc-inv: Π (x y z w: C.1) (f: C.2 x y) (g: C.2 y z) (h: C.2 z w), Path (C.2 x w) (∘ x y w f (∘ y z w g h)) (∘ x z w (∘ x y z f g) h)),
    Π (x: C.1), Path (C.2 x x) (∘ x x x (id x) (id x)) (id x)

def precategory: U₁ := Σ (C: cat), isPrecategory C
def catᵒᵖ (P: precategory) : precategory :=
    ((P.1.1, (λ (A B: P.1.1), P.1.2 B A)),
     ((λ (A : P.1.1), P.2.id A),
      (λ (A B C: P.1.1) (f: P.1.2 B A) (g: P.1.2 C B), P.2.∘ C B A g f),
      (λ (A B: P.1.1), P.2.homSet B A),
      (λ (A B: P.1.1) (f: P.1.2 B A), P.2.∘-right B A f),
      (λ (A B: P.1.1) (f: P.1.2 B A), P.2.∘-left B A f),
      (λ (A B C D: P.1.1) (f: P.1.2 B A) (g: P.1.2 C B) (h: P.1.2 D C), P.2.∘-assoc-inv D C B A h g f),
      (λ (A B C D: P.1.1) (f: P.1.2 B A) (g: P.1.2 C B) (h: P.1.2 D C), P.2.∘-assoc D C B A h g f),
      (λ (A : P.1.1), P.2.2.2.2.2.2.2.2 A)))

def opPreserve (C: precategory) : PathP (<_>precategory) (catᵒᵖ (catᵒᵖ C)) C := <i> C
def isoCat (P: precategory) (A B: P.1.1) : U
 := Σ (f: P.1.2 A B) (g: P.1.2 B A) (retract: Path (P.1.2 A A) (P.2.∘ A B A f g) (P.2.id A)), Path (P.1.2 B B) (P.2.∘ B A B g f) (P.2.id B)
def isCategory (P: precategory): U := Π (A: P.1.1), isContr (Σ (B: P.1.1), isoCat P A B)
def category: U₁ := Σ (P: precategory), isCategory P
def isInitial (P: precategory) (bot: P.1.1): U := Π (x: P.1.1), isContr (P.1.2 bot x)
def isTerminal (P: precategory) (top: P.1.1): U := Π (x: P.1.1), isContr (P.1.2 x top)
def initial (P: precategory): U := Σ (bot: P.1.1), isInitial P bot
def terminal (P: precategory): U := Σ (top: P.1.1), isTerminal P top
def homTo  (P: precategory) (X: P.1.1): U := Σ (Y: P.1.1), P.1.2 Y X
def cospan (P: precategory): U := Σ (X: P.1.1) (_: homTo P X), homTo P X
def hasCospanCone (P: precategory) (D: cospan P) (w: P.1.1) : U
 := Σ (f: P.1.2 w D.2.1.1) (g: P.1.2 w D.2.2.1), Path (P.1.2 w D.1) (P.2.∘ w D.2.1.1 D.1 f D.2.1.2) (P.2.∘ w D.2.2.1 D.1 g D.2.2.2)
def cospanCone (P: precategory) (D: cospan P): U := Σ (w: P.1.1), hasCospanCone P D w
def isCospanConeHom (P: precategory) (D: cospan P) (E1 E2: cospanCone P D) (h: P.1.2 E1.1 E2.1) : U
 := Σ (_ : Path (P.1.2 E1.1 D.2.1.1) (P.2.∘ E1.1 E2.1 D.2.1.1 h E2.2.1) E1.2.1), Path (P.1.2 E1.1 D.2.2.1) (P.2.∘ E1.1 E2.1 D.2.2.1 h E2.2.2.1) E1.2.2.1
def cospanConeHom (P: precategory) (D: cospan P) (E1 E2: cospanCone P D) : U := Σ (h: P.1.2 E1.1 E2.1), isCospanConeHom P D E1 E2 h
def isPullback (P: precategory) (D: cospan P) (E: cospanCone P D) : U := Σ (h: cospanCone P D), isContr (cospanConeHom P D h E)
def hasPullback (P: precategory) (D: cospan P) : U := Σ (E: cospanCone P D), isPullback P D E

